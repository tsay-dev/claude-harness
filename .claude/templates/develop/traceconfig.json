{
  "_comment": "Placed at the host project root as traceconfig.json. Read by .claude/tools/trace-check. The orchestrator seeds it once; the host edits source/tests/layering to match its own layout. Omit the contract block when the implementation has no single error-code source (C7 then skips). The schema block names the DB design's native source (migrations / schema.prisma / model files); omit it when the app owns no persisted data (C13 then skips).",
  "id_patterns": {
    "goal": "\\bGOAL-\\d{2}\\b",
    "uc": "\\bUC-\\d{3}\\b",
    "req": "\\bREQ-\\d{3}\\b",
    "br": "\\bBR-\\d{3}\\b",
    "nfr": "\\bNFR-\\d{3}\\b",
    "adr": "\\bADR-\\d{4}\\b"
  },
  "covers_pattern": "@covers\\s+(REQ-\\d{3})(?:#([\\w-]+))?",
  "implements_pattern": "@implements\\s+((?:REQ|BR|UC)-\\d{3})",
  "docs": {
    "goals_dir": "docs/goals",
    "goals_backlog": "docs/goals-backlog.md",
    "rules_dir": "docs/rules",
    "nfr_dir": "docs/nfr",
    "adr_dir": "docs/adr",
    "verification_global": "docs/verification/GLOBAL.md",
    "shared": "docs/_shared/components.yaml"
  },
  "source": {
    "dirs": [
      "src"
    ],
    "extensions": [
      ".ts"
    ]
  },
  "tests": {
    "dirs": [
      "tests"
    ],
    "extensions": [
      ".ts"
    ]
  },
  "schema": {
    "files": [
      "prisma/schema.prisma"
    ]
  },
  "layering": {
    "root": "src",
    "forbidden": {
      "domain": [
        "usecase",
        "infra"
      ],
      "usecase": [
        "infra"
      ]
    },
    "import_patterns": [
      "^\\s*import\\s.*from\\s+['\"][^'\"]*/{layer}(/|['\"])"
    ]
  },
  "contract": {
    "error_source": "src/domain/errors.ts",
    "error_code_pattern": "code\\s*=\\s*['\"]([A-Z_]+)['\"]",
    "exclude_codes": []
  },
  "baseline_file": ".trace-baseline.json"
}
